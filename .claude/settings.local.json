{
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(git:add:*)",
      "Bash(git:commit:*)",
      "Bash(python3:*)",
      "Bash(ls:*)",
      "Bash(echo:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(./gradlew assembleDebug:*)",
      "Bash(./gradlew:*)",
      "Bash(java:*)",
      "Bash(/usr/libexec/java_home:*)",
      "Bash(grep:*)",
      "Bash(make all:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ts/format-ts-code.sh"
          }
        ]
      }
    ]
  },
  "commands": {
    "android:run": "npx react-native run-android",
    "android:build": "cd android && ./gradlew assembleRelease",
    "android:log": "adb logcat | grep ReactNativeJS"
  }
}
