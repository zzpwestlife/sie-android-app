{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/superpowers-session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/claudeception-activator.sh"
          }
        ]
      }
    ],
    "Notification": []
  },
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Read(*.js)",
      "Read(*.jsx)",
      "Read(*.ts)",
      "Read(*.tsx)",
      "Read(*.json)",
      "Read(*.md)",
      "Read(package.json)",
      "Read(tsconfig.json)",
      "Read(android/build.gradle)",
      "Read(ios/Podfile)",
      "Read(constitution.md)",
      "Read(specs/**)",
      "Grep",
      "Glob",
      "LS",
      "Bash(npm:run:*)",
      "Bash(yarn:*)",
      "Bash(npx:*)",
      "Bash(pod:*)",
      "Bash(react-native:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(python:*)"
    ],
    "ask": [
      "Write",
      "Edit",
      "MultiEdit",
      "Bash(npm:install:*)",
      "Bash(yarn:add:*)",
      "Bash(git:add:*)",
      "Bash(git:commit:*)",
      "Bash(gem:install:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Bash(rm:*)",
      "Bash(git:push:*)",
      "WebFetch"
    ]
  }
}
